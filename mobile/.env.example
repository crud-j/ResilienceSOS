# Backend API base URL.
# - Android emulator: use 10.0.2.2 to reach the host machine.
# - Physical device: use the computer's LAN IP (e.g. http://192.168.1.100:4000)
#   or a deployed HTTPS URL.
# NEVER put DATABASE_URL, SMS credentials, or secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
